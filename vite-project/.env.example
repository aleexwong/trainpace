# Backend API Configuration
# For local development, use localhost; for production, use your deployed API
VITE_GPX_API_URL=http://localhost:3000
# Production: https://gpx-insight-api.vercel.app

# Note: VITE_GEMINI_API_KEY has been moved to backend for security
# No need to configure it here anymore

# Mapbox public token, used for course maps.
# This ships in the client bundle, so restrict it to your own hostnames in the
# Mapbox dashboard (Account > Tokens > URL restrictions) and set a spend alert.
# Client-side rate limiting (src/lib/mapbox/budget.ts) caps ordinary browsers;
# only the URL restriction stops a copied token. See docs/mapbox.md.
VITE_MAPBOX_TOKEN=
