rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // GPX uploads — readable when the owner has marked the route public,
    // always readable by the owner.
    //
    // These docs hold the full raw GPX `content`, i.e. a GPS trace that usually
    // starts at the runner's home. `allow read: if true` therefore exposed every
    // upload whether or not it had been shared, and the human-readable slug URLs
    // made those docs guessable. Reads are now gated on an explicit `isPublic`
    // flag set by the owner (see setRouteVisibility in features/dashboard/actions.ts).
    //
    // Backward compatibility: docs uploaded before `isPublic` existed have no such
    // field, and `.get(field, default)` supplies `true` for them, so every link
    // shared before this change keeps resolving. New uploads write the field
    // explicitly. Flip the default to `false` only alongside a backfill.
    match /gpx_uploads/{document} {
      allow read: if resource.data.get('isPublic', true) == true
        || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // User bookmarks for preview routes — owner only
    match /user_bookmarks/{bookmarkId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Elevation analysis cache — public read; only the creator may overwrite.
    //
    // `allow update, delete: if request.auth != null` let any signed-in user
    // overwrite or delete ANY cached analysis, including entries for other
    // people's routes — cheap cache poisoning, since these results feed the
    // pacing and difficulty numbers shown to viewers. Writes are now pinned to
    // the creating uid.
    //
    // Entries created before this change have `createdBy: ""` and are therefore
    // immutable: a re-analysis will fail the update, the caller swallows it (it
    // is only a cache), and the API is hit instead. Delete such docs to reclaim.
    match /elevation_analysis_cache/{cacheId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.get('createdBy', '') == request.auth.uid;
    }

    // User fuel plans — owner only
    match /user_fuel_plans/{planId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // User pace plans — owner only
    match /user_pace_plans/{planId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // User race plans — owner only
    match /user_race_plans/{racePlanId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // User training plans — owner only
    match /user_training_plans/{trainingPlanId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // User training goals — onboarding profile (doc id === userId), owner only.
    // Read/delete are keyed on the doc id (not resource.data) so a brand-new
    // user can getDoc a not-yet-existing doc without a permission-denied.
    // Writes additionally pin the userId field to the requester's uid.
    match /user_training_goals/{docId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == docId;
      allow create, update: if request.auth != null
        && request.auth.uid == docId
        && request.resource.data.userId == request.auth.uid;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
